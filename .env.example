# ============================================================================
# Fast CMS 配置
#
# 只有「核心配置」这一节需要你决定；下面所有高级项都已注释，注释里的值就是
# 代码默认值 —— 不写、和取消注释，运行结果完全一样。
#
# 服务端对外提供服务，一条命令即可配好本文件：
#     python scripts/install.py --server
#     python scripts/start.py server
# ============================================================================

# ---------------------------- 核心配置（必看） ----------------------------
# 运行环境：dev / production。对外开放的服务请用 production
# （production 下强制强口令、Cookie 默认下发 Secure；接口文档要另外关，见下方 APP_DOCS_ENABLED）
APP_ENV=dev

# 监听地址。127.0.0.1 = 只有本机能访问；要让其他机器访问必须改成 0.0.0.0
APP_HOST=127.0.0.1
APP_PORT=8000

# 签名密钥。留空会自动生成到 <数据根>/.secret（首次启动后固定不变）；
# 生产环境建议显式填一个随机长串，避免容器重建后卷丢失导致全员掉线
APP_SECRET_KEY=

# 初始管理员口令。留空 = 内置开发口令 fast_cms_123；
# APP_ENV=production 时留空会直接拒绝启动，必须在这里设一个强口令
INITIAL_ADMIN_PASSWORD=

# 系统时区初值（IANA 名）。首次初始化后由后台「系统参数 system.timezone」接管，
# 页面、日志、CSV 导出、通知正文与任务默认时区都跟随它
APP_TIMEZONE=Asia/Shanghai

# 刷新令牌 Cookie 的 Secure 标记。留空 = 自动：dev/test 不下发，其余环境下发。
# 用 http:// 直接访问（没有 HTTPS）时必须设为 false，否则浏览器不保存刷新令牌，
# 登录 15 分钟后会被踢出——这是内网部署最常见的坑
AUTH_COOKIE_SECURE=

# ============================================================================
# 以下为高级配置：默认值即注释中的值，需要时取消注释再改
# ============================================================================

# ---------------------------- 应用 ----------------------------
# APP_NAME=Fast CMS Admin
# APP_VERSION=0.1.0
# APP_WORKERS=1                 # >1 时必须同时把 SCHEDULER_MODE 设为 standalone
# APP_CORS_ORIGINS=             # 逗号分隔；前后端同源部署不需要
# APP_DOCS_ENABLED=true         # /docs 与 /openapi.json 开关

# ---------------------------- 路径 ----------------------------
# API_PREFIX=/api/v1            # 所有业务路由前缀；/healthz、/readyz、/docs 不受影响
# ADMIN_BASE=/admin             # 后台挂载路径；设为 / 则后台占根路径（此时前台不挂载）
# PORTAL_BASE=/front            # 前台挂载路径；设为 / 可让前台占根路径
# 两者不能相同，也不能压到 API_PREFIX 或 /docs 上，否则启动直接报错

# ---------------------------- 数据目录（重要） ----------------------------
# DATA_DIR=                     # 运行时数据根目录：SQLite 库、上传文件、签名密钥、
#                               # 迁移备份、启动锁、日志都放这里。留空 = backend/data。
#                               # 相对路径以仓库根为基准。升级代码只替换源码，
#                               # 数据留在 DATA_DIR 原地不动——要把整份数据搬到别的磁盘，
#                               # 设这个变量 + 停服迁移一次即可
# DB_PATH=                      # SQLite 库文件路径（比 DB_URL 直观）。留空 = <数据根>/fastcms.db。
#                               # 相对路径以数据根为基准；绝对路径照用。
#                               # 优先级：DB_URL > DB_PATH > 默认库路径

# ---------------------------- 数据库 ----------------------------
# DB_URL=                       # 留空 = SQLite <数据根>/fastcms.db
# DB_URL=mysql+aiomysql://fastcms:fastcms@127.0.0.1:3306/fastcms?charset=utf8mb4
# DB_ECHO=false
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_BACKUP_KEEP=20             # 迁移/备份的保留份数，0 = 不清理

# ---------------------------- Redis（可选） ----------------------------
# REDIS_ENABLED=false           # 关闭时不 import 也不连接 Redis
# REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------- 认证 ----------------------------
# AUTH_ACCESS_TTL_MIN=15
# AUTH_REFRESH_TTL_DAYS=7
# AUTH_COOKIE_NAME=fastcms_refresh
# AUTH_MAX_FAILED=5             # 同一用户名连续失败次数
# AUTH_LOCK_MINUTES=15          # 锁定分钟数
# AUTH_IP_BAN_MINUTES=30        # 同 IP 失败后自动封禁时长，0 = 关闭自动封禁

# ---------------------------- 限流与代理 ----------------------------
# RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT=30           # 单 IP 窗口内登录尝试上限
# LOGIN_RATE_WINDOW=60
# TRUST_PROXY=false             # 仅在可信反向代理之后开启，否则客户端可伪造 X-Forwarded-For
# CACHE_MAX_ITEMS=4096          # 无 Redis 时进程内缓存条目上限

# ---------------------------- 可观测性 ----------------------------
# METRICS_ENABLED=false         # 开启 /metrics（Prometheus 文本格式，进程内请求计数与耗时直方图）
# SLOW_REQUEST_THRESHOLD_MS=2000  # 单请求超过该毫秒数记一条 slow-request 警告日志（0 = 关闭）
# SLOW_SQL_THRESHOLD_MS=500     # 单条 SQL 超过该毫秒数记一条慢SQL警告日志（含 request_id）
# AUDIT_QUEUE_CAPACITY=10000    # 审计批量落库的进程内队列容量；满时降级为同步直写（不丢审计）
# AUDIT_BATCH_SIZE=200          # 审计批量落库的单批条数
# AUDIT_FLUSH_INTERVAL_SECONDS=0.2  # 审计队列的刷盘间隔（秒）
# AUDIT_MAX_RETRIES=5          # 同一批审计记录连续写失败多少轮后丢弃（带退避，防止无限重试）
# PERMISSION_DEPRECATION_GRACE_DAYS=180  # 权限码废弃宽限期：期内仍放行并回 Deprecation/Sunset 头，到期后 403 AUTH_PERMISSION_SUNSET

# ---------------------------- 定时任务 ----------------------------
# SCHEDULER_MODE=embedded       # embedded / standalone / disabled
# SCHEDULER_TIMEZONE=           # 留空 = 跟随系统时区
# SCHEDULER_JOB_TIMEOUT=300
# SCHEDULER_SYNC_SECONDS=30
# SCHEDULER_MISFIRE_GRACE_SECONDS=300
# SCHEDULER_EMBEDDED_MULTIWORKER=false   # APP_WORKERS>1 + embedded 默认拒绝；true 显式放行（自担风险，A-9）
# Python 脚本任务（同权限子进程）默认关闭（P1-12）；开启请理解「等价进程权限」风险，
# 并确认只有受信管理员持有 schedule:job:code。注释里的值即代码默认值 = false。
# SCHEDULER_PYTHON_ENABLED=false

# ---------------------------- 存储 ----------------------------
# STORAGE_LOCAL_DIR=            # 留空 = <数据根>/uploads
# UPLOAD_MAX_MB=20

# ---------------------------- 日志与数据保留 ----------------------------
# 内置清理任务的统一保留天数（日志 / 会话 / 未引用文件共用）。只在首次初始化时
# 作为任务种子参数写入，之后可在「任务管理」里按任务单独调整，互不影响
# RETENTION_DAYS=30

# ---------------------------- 消息通知 ----------------------------
# NOTIFY_ENABLED=true
# NOTIFY_TIMEOUT_SECONDS=10     # 单次推送 HTTP 超时（1-60）
# NOTIFY_MAX_ATTEMPTS=5         # 自动重试上限，指数退避 60s 起、最长 1800s
# NOTIFY_BATCH_SIZE=20          # 单轮投递取出的记录数（1-60）
# NOTIFY_ALLOW_PRIVATE_TARGET=false  # 放开内网/回环地址，仅自建内网网关时需要

# ---------------------------- 离线 IP 归属地 ----------------------------
# IP2REGION_ENABLED=true        # 关闭后不做归属地解析
# IP2REGION_CACHE_POLICY=vectorIndex  # file / vectorIndex / content
# IP2REGION_DATA_DIR=           # 留空 = backend/app/ip_data（xdb 随源码分发）

# ---------------------------- 启动 ----------------------------
# AUTO_MIGRATE=false            # 裸机/手工部署：生产推荐用 CLI 显式迁移（python -m app.cli db upgrade）
#                               # 容器部署：镜像与 compose 的 app 服务默认 true，由 entrypoint 在
#                               # 启动时加数据库级迁移锁后执行迁移；scheduler 等其它服务固定 false，
#                               # 保证同一套库只有一个入口执行迁移。两种默认值按部署形态区分，不是冲突。
