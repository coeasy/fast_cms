# ===== 应用 =====
APP_NAME=Fast CMS Admin
APP_VERSION=0.1.0
APP_ENV=dev
# 默认只监听本机回环；对外发布时改成 0.0.0.0
APP_HOST=127.0.0.1
APP_PORT=8000
APP_WORKERS=1
# 留空则自动生成到 backend/data/.secret
APP_SECRET_KEY=
APP_CORS_ORIGINS=
# 系统时区初值（IANA 时区名）。首次种子后由系统参数 system.timezone 接管：
# 后台「系统参数」里改完立刻生效并在重启时读回，这里的值只在参数缺失时兜底。
APP_TIMEZONE=Asia/Shanghai
APP_DOCS_ENABLED=true

# ===== API 前缀 =====
# 后端所有业务路由挂载在该前缀下（健康检查 /healthz、/readyz 与 /docs 除外）。
# 页面在服务端渲染时直接把这个前缀注入到 <script> 里，改完重启即可，无需构建。
API_PREFIX=/api/v1

# ===== 站点挂载路径 =====
# 后台挂 ADMIN_BASE、前台挂 PORTAL_BASE，两个前缀都只改这里：
# 页面路由、静态资源路径与前端请求前缀都由后端在渲染时算好，改完重启即生效。
# 访问站点根路径 / 时会 307 跳到前台；把 PORTAL_BASE 设为 / 可恢复「前台占根路径」的老形态。
# 两者不能相同，也不能压到 API_PREFIX 或 /docs 等后端保留路径上（启动时会直接报错）。
ADMIN_BASE=/admin
PORTAL_BASE=/front

# ===== 数据库 =====
# 默认 SQLite，无需启动 MySQL；留空使用 backend/data/fastcms.db 绝对路径
# DB_URL=sqlite+aiosqlite:///./data/fastcms.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# SQLite 迁移/手动备份的最大保留份数（backend/data/backups/），超出按时间清理最旧的；0 表示不清理
DB_BACKUP_KEEP=20
# MySQL 示例：
# DB_URL=mysql+aiomysql://fastcms:fastcms@127.0.0.1:3306/fastcms?charset=utf8mb4

# ===== Redis（可选，默认关闭） =====
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 认证 =====
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=7
AUTH_COOKIE_NAME=fastcms_refresh
# 留空 = 自动：APP_ENV 属于 dev/development/local/test/pytest 时不下发 Secure，其余环境默认下发
# 仅当 TLS 在反向代理终止、回源为明文 HTTP 时才显式设为 false
AUTH_COOKIE_SECURE=
AUTH_MAX_FAILED=5
AUTH_LOCK_MINUTES=15

# ===== 限流与代理 =====
# 登录与敏感接口（导出、上传、改密、重置密码、日志清理、代码生成写库）的窗口限流总开关
RATE_LIMIT_ENABLED=true
# 单 IP 在窗口内的登录尝试上限，超限返回 429 AUTH_RATE_LIMITED
LOGIN_RATE_LIMIT=30
LOGIN_RATE_WINDOW=60
# 仅当应用位于可信反向代理之后才开启：开启后取 X-Forwarded-For 首跳作为客户端 IP。
# 关闭（默认）只信任直连来源，客户端伪造该头无法绕过限流或污染审计日志。
# 同机 nginx 无需开启：uvicorn 的 FORWARDED_ALLOW_IPS（默认 127.0.0.1,::1）已会改写来源 IP。
TRUST_PROXY=false

# ===== 缓存 =====
# 未启用 Redis 时进程内缓存（限流计数、字典、参数）的条目上限，超出时清理过期项并淘汰最早写入
CACHE_MAX_ITEMS=4096

# ===== 调度器 =====
# embedded / standalone / disabled
SCHEDULER_MODE=embedded
# 留空 = 任务默认时区跟随系统时区（APP_TIMEZONE / 系统参数 system.timezone）；
# 只有需要让调度时区与展示时区分开时才填具体 IANA 时区名。
SCHEDULER_TIMEZONE=
SCHEDULER_JOB_TIMEOUT=300
SCHEDULER_SYNC_SECONDS=30
# 到点后仍允许补跑的宽限秒数；超过则记一条 skipped（错过执行时间），不会静默丢弃；设为 0 表示不限宽限、到点必跑一次
SCHEDULER_MISFIRE_GRACE_SECONDS=300
# 关闭后将禁止创建、恢复、触发 Python 脚本任务（高危能力，默认仅超管可用）
SCHEDULER_PYTHON_ENABLED=true

# ===== 存储 =====
# 留空使用 backend/data/uploads
# STORAGE_LOCAL_DIR=./data/uploads
UPLOAD_MAX_MB=20

# ===== 日志与保留 =====
# 以下三项只决定「内置清理任务」种子参数的默认天数，可在任务管理里按任务调整
LOG_RETENTION_DAYS=90
SESSION_RETENTION_DAYS=30
FILE_RETENTION_DAYS=30

# ===== 消息通知（多 IM 推送） =====
# 总开关：关闭后任务失败与公告发布不再入队，已入队的消息也不会投递
NOTIFY_ENABLED=true
# 单次 HTTP 推送超时秒数（1-60）
NOTIFY_TIMEOUT_SECONDS=10
# 自动重试上限，达到后置为 failed；指数退避 60s 起、最长 1800s
NOTIFY_MAX_ATTEMPTS=5
# 单次「通知消息投递」任务取出的记录数上限（1-60）
NOTIFY_BATCH_SIZE=20
# 默认拒绝指向内网、回环与保留网段的推送地址（防 SSRF）。
# 仅本地联调或推送给自建内网网关时设为 true，同时会放开非默认端口
NOTIFY_ALLOW_PRIVATE_TARGET=false

# ===== 启动 =====
# 生产环境是否自动执行迁移（推荐用 CLI 显式迁移）
AUTO_MIGRATE=false
# 留空使用内置默认口令 fast_cms_123（仅供本地开发；APP_ENV=prod|production 必须显式设置强口令）
INITIAL_ADMIN_PASSWORD=
